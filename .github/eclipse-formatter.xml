<?xml version="1.0" encoding="UTF-8"?>
<profiles version="12">
  <profile kind="CodeFormatterProfile" name="Luxtronic" version="12">
    <!-- Maximum line length -->
    <setting id="org.eclipse.jdt.core.formatter.lineSplit" value="180"/>
    <!-- Import order: java, javax, org, lombok, github, then others -->
    <setting id="org.eclipse.jdt.core.formatter.importOrder" value="java,javax,org,lombok,github,*"/>
